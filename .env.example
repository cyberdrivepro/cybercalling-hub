# OmniDimension Multi-Account Configuration
OMNIDIM_API_KEY=your_omnidimension_api_key_here
OMNIDIM_API_KEYS=your_omnidimension_api_key_1,your_omnidimension_api_key_2
OMNIDIM_BASE_URL=https://backend.omnidim.io/api/v1

# Telegram Bot Integration (@Cybercalling_bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=Cybercalling_bot

# Telegram Admin Encrypted Key Vault Bot (@Cybercallingadmin_bot)
TELEGRAM_ADMIN_BOT_TOKEN=your_telegram_admin_bot_token_here
TELEGRAM_ADMIN_BOT_USERNAME=Cybercallingadmin_bot

# Twilio Telephony Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Telnyx SIP Trunk Configuration
SIP_DOMAIN=sip.telnyx.com
SIP_CALLER_ID=your_telnyx_phone_number
SIP_USERNAME=your_sip_username
SIP_PASSWORD=your_sip_password
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_CONNECTION_ID=your_connection_id
